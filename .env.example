# Copiar este archivo como .env y completar los valores.

# Puerto local (Render lo asigna automáticamente)
PORT=3000

# Cadena de conexión de PostgreSQL (Render la asigna sola con render.yaml)
DATABASE_URL=

# (Alternativa) Cadena de conexión de MongoDB Atlas (base de datos en la nube).
# Si DATABASE_URL y MONGODB_URI están vacías, los datos se guardan en data/estudiantes.json (solo para pruebas locales).
MONGODB_URI=

# Claves de Google reCAPTCHA v2 ("No soy un robot").
# Si se dejan vacías se usan las claves de PRUEBA oficiales de Google.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
